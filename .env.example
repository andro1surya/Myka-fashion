# =====================================================================
# MYKA FASHION - ENVIRONMENT CONFIGURATION
# =====================================================================
# Copy this file to .env.local and populate with your production keys.
# The application automatically runs in Demonstration/Local Fallback mode
# with all features (Inquiry List, Form Submissions, Admin Dashboard,
# Product Management, Lead Capture) working seamlessly until real credentials
# are connected.

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://mykafashion.com
NEXT_PUBLIC_COMPANY_NAME="MYKA FASHION"
NEXT_PUBLIC_CONTACT_EMAIL=wholesale@mykafashion.com
# Set verified WhatsApp number with country code (e.g. 919876543210) to activate live click-to-chat
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase (PostgreSQL Database, Storage & Auth)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Resend Transactional Email
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_123456789...
EMAIL_FROM="MYKA FASHION Export Desk <inquiries@mykafashion.com>"
SALES_NOTIFICATION_EMAIL=wholesale@mykafashion.com

# Admin Authentication
# Used to log into /admin management dashboard
ADMIN_EMAIL=admin@mykafashion.com
ADMIN_PASSWORD=MykaAdmin2026!
ADMIN_JWT_SECRET=super-secret-random-key-change-in-production

# Google Analytics 4 (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
